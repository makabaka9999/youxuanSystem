CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_PATH=logs

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
