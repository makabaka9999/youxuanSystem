PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
MERCHANT_SERVICE_PORT=8084
FINANCE_SERVICE_PORT=8085
ADMIN_SERVICE_PORT=8086
APP_ENV=local

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=youxuan_p0
